{
  "name": "heimdall",
  "version": "1.0.0",
  "description": "HEIMDALL - Hostel Management Platform",
  "scripts": {
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "seed": "cd backend && node seed.js",
    "seed-test-users": "NODE_PATH=backend/node_modules node load-tests/seedUsers.js",
    "cleanup-test-users": "NODE_PATH=backend/node_modules node load-tests/cleanupUsers.js",
    "loadtest": "NODE_PATH=backend/node_modules node load-tests/runner.js",
    "qr-loadtest": "NODE_PATH=backend/node_modules node load-tests/qrStressTester.js",
    "stress-test": "NODE_PATH=backend/node_modules node load-tests/runner.js --stress",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.11"
  }
}
