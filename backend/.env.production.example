# ─────────────────────────────────────────────────────────────────────────────
# HEIMDALL Production Environment Template (Oracle Cloud VM / Self-Hosted Docker)
# Copy this file to backend/.env and fill in your real values before deploying.
#
# ⚠️  NEVER commit the actual .env file to version control.
# ⚠️  All required secrets must be set with cryptographically random strings.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ── Database (Internal Docker network - Not exposed publicly) ───────────────────
MONGODB_URI=mongodb://mongo:27017/heimdall
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# ── Redis (Internal Docker network - Not exposed publicly) ─────────────────────
# Used for BullMQ queues, distributed scan locking, rate limiting, and session cache
REDIS_URL=redis://redis:6379
REQUIRE_REDIS_IN_PRODUCTION=true

# ── Secrets (MUST be cryptographically random strings, min 32 chars) ───────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_96_char_random_hex_string
QR_SECRET=replace_with_different_96_char_random_hex_string
SESSION_SECRET=replace_with_third_96_char_random_hex_string

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://api.YOURDOMAIN.com/api/auth/google/callback
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# ── CORS & Domain URLs ────────────────────────────────────────────────────────
# Your deployed frontend on Vercel (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
# Vercel domain without protocol (also checked by CORS)
VERCEL_URL=your-app.vercel.app
# Multiple frontend origins (comma-separated):
# FRONTEND_URLS=https://your-app.vercel.app,https://your-custom-domain.com

# Public URL of this backend API (used in QR image links and OAuth redirects)
PUBLIC_BACKEND_URL=https://api.YOURDOMAIN.com

# Domain used by Caddy for automatic Let's Encrypt SSL
API_DOMAIN=api.YOURDOMAIN.com

# SECURITY: Disable unverified Vercel preview URL access in production
ALLOW_VERCEL_PREVIEWS=false

# ── Campus Scale & Limits ─────────────────────────────────────────────────────
CAMPUS_STUDENT_CAPACITY=15000
PENDING_QR_LIST_LIMIT=500
QR_EXPIRY_SECONDS=3600
INOUT_REQUEST_EXPIRY_SECONDS=900
QR_PNG_RETENTION_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# 15 minutes window, max requests
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=5000

# ── WhatsApp / Twilio Notifications ───────────────────────────────────────────
# Set SIMULATE_WHATSAPP=false to send real WhatsApp messages via Twilio
SIMULATE_WHATSAPP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── College Email Restriction ─────────────────────────────────────────────────
COLLEGE_EMAIL_DOMAIN=iiitpune.ac.in

# ── Body Size Limit ───────────────────────────────────────────────────────────
REQUEST_BODY_LIMIT=10mb

# ── Archival Storage (Cloudflare R2) ──────────────────────────────────────────
# Optional: set ARCHIVE_ENABLED=false if R2 is not used
ARCHIVE_ENABLED=false
ARCHIVE_RETENTION_MONTHS=3
ARCHIVE_CRON=0 2 1 * *
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heimdall-archives
R2_ENDPOINT=
