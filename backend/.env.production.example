# ─────────────────────────────────────────────────────────────────────────────
# HEIMDALL Production Environment Template
# Copy to .env and fill in all values before deploying.
#
# ⚠️  NEVER commit the actual .env file to version control.
# ⚠️  All required vars must be set — the server will refuse to start otherwise.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — same region as your API server for low latency
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hostel?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://REPLACE_ME:REPLACE_ME@cluster.mongodb.net/hostel?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Required in production for: distributed scan locks, session cache, BullMQ queues
# Upstash Redis (serverless): redis://default:PASSWORD@HOST:PORT
# Redis Cloud: redis://:PASSWORD@HOST:PORT
REDIS_URL=rediss://default:REPLACE_ME@REPLACE_HOST:REPLACE_PORT
REQUIRE_REDIS_IN_PRODUCTION=true

# ── Security (MUST be cryptographically random, min 32 chars) ─────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_96_CHAR_RANDOM_HEX_STRING
QR_SECRET=REPLACE_WITH_DIFFERENT_96_CHAR_RANDOM_HEX_STRING

# ── CORS & URLs ───────────────────────────────────────────────────────────────
# Must exactly match your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://heimdall.vercel.app
# Multiple frontends (comma-separated):
# FRONTEND_URLS=https://heimdall.vercel.app,https://heimdall-admin.vercel.app

# Public URL of this backend (used in QR image links)
PUBLIC_BACKEND_URL=https://heimdall-api.onrender.com

# SECURITY: Disable Vercel preview URL access in production
ALLOW_VERCEL_PREVIEWS=false

# ── Campus Scale ──────────────────────────────────────────────────────────────
CAMPUS_STUDENT_CAPACITY=15000
PENDING_QR_LIST_LIMIT=500
QR_EXPIRY_SECONDS=3600
INOUT_REQUEST_EXPIRY_SECONDS=900
QR_PNG_RETENTION_DAYS=7

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Increase for large campuses with many guards (each guard = ~100 req/min)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=5000

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────────
SIMULATE_WHATSAPP=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── College Domain ────────────────────────────────────────────────────────────
COLLEGE_EMAIL_DOMAIN=iiitpune.ac.in

# ── Body size ─────────────────────────────────────────────────────────────────
REQUEST_BODY_LIMIT=1mb
