NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/hostel
# Production: MongoDB Atlas in the same region as your API
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/hostel?retryWrites=true&w=majority

# ── Secrets ───────────────────────────────────────────────────────────────────
# JWT_SECRET: Signs the JWT (15d) issued after Google OAuth callback.
JWT_SECRET=replace_with_long_random_secret_min_32_chars
QR_SECRET=replace_with_different_long_random_secret_min_32_chars
# SESSION_SECRET: Secures the express-session cookie used during OAuth handshake.
SESSION_SECRET=replace_with_another_long_random_secret_min_32_chars

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorized redirect URI (dev):  http://localhost:5001/api/auth/google/callback
# Authorized redirect URI (prod): https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Role Access Control ───────────────────────────────────────────────────────
# Comma-separated list of emails permitted for the Hostel Staff / Warden portal:
#   WARDEN_ALLOWED_EMAILS=laxmanshinde@iiitp.ac.in,angadborge691@gmail.com,saurabhkumar78540@gmail.com,navinthakur@iiitp.ac.in,kirti.more@iiitp.ac.in,minakshi@iiitp.ac.in,kaaustubhkhandare@gmail.com,sjyotik2005@gmail.com,aniketwandre2914@gmail.com,parthrajsolanke@gmail.com,mohitmoksh810@gmail.com,mahesh.joshi@iiitp.ac.in
WARDEN_ALLOWED_EMAILS=laxmanshinde@iiitp.ac.in,angadborge691@gmail.com,saurabhkumar78540@gmail.com,navinthakur@iiitp.ac.in,kirti.more@iiitp.ac.in,minakshi@iiitp.ac.in,kaaustubhkhandare@gmail.com,sjyotik2005@gmail.com,aniketwandre2914@gmail.com,parthrajsolanke@gmail.com,mohitmoksh810@gmail.com,mahesh.joshi@iiitp.ac.in
SECURITY_ALLOWED_EMAILS=

# ── Campus scale (~3000 students) ─────────────────────────────────────────────
CAMPUS_STUDENT_CAPACITY=3000
INOUT_REQUEST_EXPIRY_SECONDS=900
PENDING_QR_LIST_LIMIT=500
QR_EXPIRY_SECONDS=3600
QR_PNG_RETENTION_DAYS=7
REQUIRE_REDIS_IN_PRODUCTION=true

# Required in production for pending in/out + active home QRs + scan locks + session store
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=redis://default:<password>@<host>:<port>

MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:5001
REQUEST_BODY_LIMIT=1mb

# Higher limits for many students hitting API during rush hour
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=3000

SIMULATE_WHATSAPP=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── Automated Archival & Cloudflare R2 ─────────────────────────────────────────
ARCHIVE_ENABLED=true
ARCHIVE_RETENTION_MONTHS=3
ARCHIVE_CRON=0 2 1 * *

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heimdall-archives
R2_ENDPOINT=

# ── Attendance Module (Room-by-Room Staff Round) ──────────────────────────────
ATTENDANCE_MODULE_ENABLED=true

# ── Room Allocation Module ───────────────────────────────────────────────────
ROOM_ALLOCATION_MODULE_ENABLED=true

ATTENDANCE_REQUEST_TTL_SECONDS=90
AUTO_APPROVE_INITIAL_DEVICE=true

# ── Parent Linking & Digital Approval Module ──────────────────────────────────
# Comma-separated list of allowed student college email domains:
ALLOWED_COLLEGE_EMAIL_DOMAINS=iiitpune.ac.in,cse.iiitp.ac.in,ece.iiitp.ac.in,cysec.iiitp.ac.in,aids.iiitp.ac.in,mevd.iiitp.ac.in,iiitp.ac.in,college.edu

# Approval policy: ANY_ONE (first parent decides) or ALL (both parents must approve)
PARENT_APPROVAL_POLICY=ANY_ONE

# Window in hours before an unapproved parent request expires (default 24)
PARENT_APPROVAL_EXPIRY_HOURS=24

# ── Completely Free Google Apps Script Email Relay (₹0 Budget) ───────────────
# Deployed Web App URL from script.google.com (uses MailApp free quota)
GOOGLE_APPS_SCRIPT_URL=
# Shared secret configured in Apps Script Script Properties (HEIMDALL_SHARED_SECRET)
GOOGLE_APPS_SCRIPT_SECRET=
# Base URL of frontend application for email review links
APP_BASE_URL=https://iiitpune-hosteel-gate-management.vercel.app

# ── SMTP Email Transport (Optional in dev, falls back to console mock) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HEIMDALL Campus Management" <no-reply@campus.edu>


